# =====================================================================
# MundoGlobal Travel - Motor Orquestador Backend
# Copie este archivo a .env (o ejecute infrastructure/scripts/setup-env.sh
# o setup-env.ps1, que lo genera con secretos aleatorios).
# Los valores CHANGE_ME_* y los vacios NO sirven: la API se niega a iniciar con ellos.
# =====================================================================

# --- General ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Origenes permitidos para CORS, separados por coma (dashboard Next.js)
CORS_ORIGINS=http://localhost:3000
# true solo si hay un proxy inverso de confianza delante de la API
TRUST_PROXY=false

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=mgt
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=mgt
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mgt:CHANGE_ME_postgres_password@localhost:5432/mgt?schema=public

# --- Redis (colas y rate limiting compartido; se usa desde la Etapa 3) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Simulador de proveedores (provider-simulator, Etapa 3) ---
SIMULATOR_PORT=4100
# URL con la que el backend y las pruebas llegan al simulador
SIMULATOR_URL=http://localhost:4100
# Token de la API de control (inyeccion de fallas). Minimo 24 caracteres. Vacio = control deshabilitado.
SIMULATOR_ADMIN_TOKEN=
# Si se define, el simulador exige X-API-Key en las rutas de proveedor
SIMULATOR_API_KEY=

# --- Reservas y trabajos en segundo plano (Etapa 3) ---
# Planificador: vencimiento de bloqueos, conciliacion de confirmaciones y sincronizacion con proveedores
JOBS_ENABLED=true
HOLD_TTL_MINUTES=15
QUOTE_TTL_MINUTES=30
RECONCILE_INTERVAL_SECONDS=30
SYNC_INTERVAL_MINUTES=15
SYNC_WINDOW_DAYS=14

# --- Seguridad ---
# Minimo 32 caracteres aleatorios. Generar: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_min_32_chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Clave AES-256 (32 bytes en base64) para cifrar credenciales de proveedores.
# Generar: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
# Rate limiting global (peticiones por ventana) y para login
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
LOGIN_THROTTLE_LIMIT=5
# En produccion los endpoints de proveedores deben ser https; ponga true solo en desarrollo
ALLOW_INSECURE_PROVIDER_URLS=true

# --- Datos iniciales (solo desarrollo/pruebas; npm run prisma:seed) ---
SEED_ADMIN_EMAIL=admin@mundoglobal.local
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_EMAIL=operador@mundoglobal.local
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_EMAIL=consulta@mundoglobal.local
SEED_VIEWER_PASSWORD=
