# URL del backend (solo la usa el servidor de Next.js; el navegador nunca habla con el backend directamente)
API_URL=http://localhost:3001
# Debe coincidir con REFRESH_TOKEN_TTL_DAYS del backend (vida de la cookie de sesion)
REFRESH_TOKEN_TTL_DAYS=7
# En produccion las cookies son Secure (requieren https). Solo para pruebas locales sin https en modo produccion:
# COOKIE_SECURE=false
